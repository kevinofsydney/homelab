# Copy to .env on the VM, chmod 600, never commit.
# Reviewed public image references on 2026-10-27; recheck releases before deployment.
PAPERLESS_IMAGE=ghcr.io/paperless-ngx/paperless-ngx:3.3.4@sha256:9bc6e8248891bcfa6f52fffe8b81e4ea8cae75790c3ec1b9906961a7ba55c969
POSTGRES_IMAGE=postgres:17-trixie@sha256:b8faeff7712663c2773a190181e1246e37e364b887611c04658c28b44e2408fe
VALKEY_IMAGE=valkey/valkey:8@sha256:8f836008e0986c36adf50da714c7060cf689dbb335f61fe077939d90fa650809
PAPERLESS_LOCAL_ROOT=/srv/paperless
PAPERLESS_NAS_ROOT=/mnt/qnap-paperless
PAPERLESS_NAS_SOURCE=REPLACE_NAS_HOST:/REPLACE_PAPERLESS_EXPORT
PAPERLESS_BACKUP_MOUNT=/mnt/qnap-backups
PAPERLESS_BACKUP_SOURCE=REPLACE_NAS_HOST:/REPLACE_BACKUP_EXPORT
PAPERLESS_BIND_IP=REPLACE_TAILSCALE_IP
PAPERLESS_PORT=8000
PAPERLESS_URL=http://REPLACE_TAILSCALE_NAME:8000
PAPERLESS_TIME_ZONE=Australia/Sydney
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_UID=REPLACE_VERIFIED_UID
PAPERLESS_GID=REPLACE_VERIFIED_GID
PAPERLESS_DB_PASSWORD=REPLACE_GENERATED_SECRET
PAPERLESS_SECRET_KEY=REPLACE_GENERATED_SECRET
