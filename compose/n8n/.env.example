# Copy to /opt/homelab/n8n/.env on the n8n VM (root-owned, mode 0600). Never commit the copy.
# Placeholders below must be replaced; deploy-n8n.sh refuses to start while any remain.

# Confirm the cloud instance's default timezone before cutover; schedules without their own
# timezone follow this value.
N8N_TIMEZONE=Australia/Sydney

# Editor address. With `tailscale serve` this is the VM's MagicDNS HTTPS name, protocol https,
# an empty port suffix and one proxy hop. For SSH-tunnel-only use: localhost, http, :5678, 0.
N8N_PUBLIC_HOST=REPLACE_TAILSCALE_NAME
N8N_PUBLIC_PROTOCOL=https
N8N_PUBLIC_PORT_SUFFIX=
N8N_PROXY_HOPS=1

# Random path of the router's Webhook node, e.g. from `openssl rand -hex 16`. Not a secret on
# its own (the header secret authenticates), but keep it out of Git.
RELAY_WEBHOOK_PATH=REPLACE_GENERATED_PATH

# Numeric Telegram user IDs allowed to reach the router, comma-separated.
TELEGRAM_ALLOWED_USER_IDS=REPLACE_OWNER_ID

# Expected NFS source of /mnt/qnap-backups, checked before every backup (server:/export).
N8N_BACKUP_SOURCE=REPLACE_NAS_HOST:/REPLACE_EXPORT

# Directory holding telegram_bot_token and relay_shared_secret (each mode 0400, owner 1000).
N8N_SECRETS_DIR=/opt/homelab/n8n/secrets
