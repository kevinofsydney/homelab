# REVIEW ONLY. Proposed /etc/pve/firewall/<n8n VM ID>.fw for the dedicated n8n VM.
# Replace ROUTER_IPV4, NAS_IPV4 and OPERATOR_IPV4 from verified private site inventory.
# Same egress model as Hermes: public internet allowed, every private range rejected.
# Tailscale works through outbound NAT traversal and DERP; no inbound port is opened for it.
[OPTIONS]
enable: 1
policy_in: DROP
policy_out: ACCEPT
dhcp: 1
ndp: 1
macfilter: 1

[RULES]
# Administrator SSH from the operator's trusted device only; editor access is over Tailscale.
IN ACCEPT -source OPERATOR_IPV4 -p tcp -dport 22
OUT ACCEPT -dest ROUTER_IPV4 -p udp -dport 53
OUT ACCEPT -dest ROUTER_IPV4 -p tcp -dport 53
# Nightly backups to the dedicated QNAP backup export (NFSv4).
OUT ACCEPT -dest NAS_IPV4 -p tcp -dport 2049
OUT REJECT -dest 192.168.0.0/16
OUT REJECT -dest 10.0.0.0/8
OUT REJECT -dest 172.16.0.0/12
OUT REJECT -dest 169.254.0.0/16
OUT REJECT -dest 100.64.0.0/10
OUT REJECT -dest ::/0
